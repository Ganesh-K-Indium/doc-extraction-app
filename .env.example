# Settings for `docker compose up`. Everything here is optional; copy this file to .env to use it.
# Provider keys can also be entered later on the app's Settings page (stored encrypted in the data volume).

WEB_PORT=8080

# Require this key on every API call. The web app adds it on the server side, so it never reaches the browser,
# which means anyone who can open the web app can use it: put the web app behind your own login or VPN if that matters.
APP_API_KEY=
# Encrypts keys saved on the Settings page. Set it, and keep it out of the data volume.
APP_SECRET_KEY=

# Model providers (leave blank to use local OCR only, or to add them in Settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# From inside a container, a model on your own machine is at host.docker.internal
OLLAMA_BASE_URL=
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
LLM_CUSTOM_MODEL=

# How scanned pages are read when a workspace has not chosen: economy | balanced | accuracy
READING_STRATEGY=balanced
LOCAL_OCR_ENGINE=tesseract
ESCALATE_BELOW=0.85
TOKEN_CAP=0

# 1 = cloud providers are switched off, nothing leaves the machine.  1 = the Settings page is read-only.
LOCAL_ONLY=0
LOCK_SETTINGS=0
LLM_ENABLED=1

<</JS(var TT_GROUPS = {"reason": ["S1A_Reason_1_InitialApplication", "S1A_Reason_2_ChangeOfInformation", "S1A_Reason_3_Deactivation", "S1A_Reason_4_Reactivation"], "deact": ["S1A_3_DeactivationReason_Death", "S1A_3_DeactivationReason_BusinessDissolved", "S1A_3_DeactivationReason_Other"], "entity": ["S1B_EntityType_1_Individual", "S1B_EntityType_2_Organization"], "soleprop": ["S1B_1_SoleProprietor_Yes", "S1B_1_SoleProprietor_No"], "subpart": ["S1B_2_Subpart_Yes", "S1B_2_Subpart_No"], "othername": ["S2A_13_TypeOfOtherName_FormerName", "S2A_13_TypeOfOtherName_ProfessionalName", "S2A_13_TypeOfOtherName_Other"], "sex": ["S2A_17_Sex_Male", "S2A_17_Sex_Female"], "orgothername": ["S2B_4_TypeOfOtherName_FormerLegalBusinessName", "S2B_4_TypeOfOtherName_DBAName", "S2B_4_TypeOfOtherName_Other"]};\nfunction TT_selectOne\(gname, me\) {\n    var f = this.getField\(me\);\n    if \(f == null || f.value == 'Off'\) return;\n    var group = TT_GROUPS[gname];\n    for \(var i = 0; i < group.length; i++\) {\n        if \(group[i] == me\) continue;\n        var g = this.getField\(group[i]\);\n        if \(g != null && g.value != 'Off'\) g.checkThisBox\(0, false\);\n    }\n}\nfunction TT_deactOther\(\) {\n    // 'Other, Specify' text only applies when the Other box is checked\n    if \(this.getField\('S1A_3_DeactivationReason_Other'\).value == 'Off'\)\n        this.getField\('S1A_3_DeactivationReason_OtherSpecify'\).value = '';\n}\nfunction TT_subpart\(\) {\n    // Parent LBN/TIN are only entered when the organization IS a subpart\n    if \(this.getField\('S1B_2_Subpart_No'\).value != 'Off'\) {\n        this.getField\('S1B_2_ParentOrganizationLBN'\).value = '';\n        this.getField\('S1B_2_ParentOrganizationTIN'\).value = '';\n    }\n}\n)/S/JavaScript>>
endobj

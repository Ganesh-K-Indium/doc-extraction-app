OPENAI_API_KEY=
# Two readers: primary (kept) , secondary (cross-check). Only gpt-4-series by cost policy.
HANDWRITING_OCR_MODELS=gpt-4.1,gpt-4.1-mini
EXTRACTION_MODELS=gpt-4.1,gpt-4.1-mini
# Optional: when set, every request must send X-API-Key
APP_API_KEY=
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
# Set to 0 to disable all model calls (text-layer + rules only)
LLM_ENABLED=1

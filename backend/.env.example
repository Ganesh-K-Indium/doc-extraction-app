# Model providers are optional here: they can also be connected on the app's Settings page (stored encrypted).
# Digital PDFs and local OCR work with none of them.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_CUSTOM_BASE_URL=            # any OpenAI-compatible server, e.g. vLLM
# Encrypts keys saved on the Settings page. Keep it outside DATA_DIR in production. Without it a random key is kept in DATA_DIR/secret.key.
# APP_SECRET_KEY=

# How scanned pages are read when a workspace has not chosen: economy | balanced | accuracy
# READING_STRATEGY=balanced
# LOCAL_OCR_ENGINE=tesseract        # tesseract | rapidocr | paddleocr | doctr
# ESCALATE_BELOW=0.85
# TOKEN_CAP=0
# Reader pair when nobody chose (otherwise the connected provider's default). Use provider:model for non-OpenAI models.
# EXTRACTION_MODELS=gpt-4.1,gpt-4.1-mini
# HANDWRITING_OCR_MODELS=gpt-4.1,gpt-4.1-mini

# Nothing leaves this machine: cloud providers are switched off (local OCR and your own models still work)
# LOCAL_ONLY=0
# Make the Settings page read-only (configuration managed through the environment)
# LOCK_SETTINGS=0
# When set, every request must send X-API-Key
APP_API_KEY=
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
# Set to 0 to disable all model calls (text-layer + rules only)
LLM_ENABLED=1
